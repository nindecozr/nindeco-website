<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>NINDECO — IKEA Kitchen Installation in Klang Valley</title>
  <meta name="description" content="NINDECO — Trusted IKEA kitchen installer. Installation, quartz tops, plumbing & electrical. Serving Klang Valley, Selangor, Putrajaya, NS & Melaka."/>
  <style>
    :root{
      --bg:#ffffff;
      --accent:#d9302f; /* red */
      --muted:#6b6b6b;
      --dark:#111;
      --card:#f8f8f8;
      --accent-2:#9aa0a6; /* grey */
      font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--dark);-webkit-font-smoothing:antialiased}
    .container{max-width:1100px;margin:0 auto;padding:28px}
    header{display:flex;align-items:center;justify-content:space-between;padding:12px 0}
    .logo{display:flex;align-items:center;gap:12px}
    .logo img{height:48px}
    nav{display:flex;gap:18px;align-items:center}
    nav a{color:var(--muted);text-decoration:none;font-weight:600}
    .hero{display:grid;grid-template-columns:1fr 480px;gap:28px;align-items:center;padding:24px 0}
    .hero h1{font-size:42px;margin:0 0 12px}
    .hero p.lead{font-size:18px;color:var(--muted);margin:0 0 20px}
    .btn{display:inline-block;background:var(--accent);color:#fff;padding:14px 20px;border-radius:8px;text-decoration:none;font-weight:700}
    .small{font-size:14px;color:var(--muted)}
    .services{background:linear-gradient(0deg, #fff, #fff);padding:26px 0}
    .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:14px}
    .service{background:var(--card);padding:18px;border-radius:10px}
    .service h4{margin:0 0 8px}
    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
    .gallery img{width:100%;height:200px;object-fit:cover;border-radius:8px}
    .testimonials{margin-top:28px}
    .testimonial{background:#fff;padding:18px;border-left:4px solid var(--accent);border-radius:6px;margin-bottom:12px}
    footer{margin-top:30px;padding:18px 0;border-top:1px solid #eee;display:flex;justify-content:space-between;align-items:center}
    .contact-card{background:var(--card);padding:18px;border-radius:10px;max-width:420px}
    .contact-card p{margin:8px 0}
    /* Responsive */
    @media (max-width:980px){
      .hero{grid-template-columns:1fr}
      .service-grid{grid-template-columns:repeat(2,1fr)}
      .gallery{grid-template-columns:repeat(2,1fr)}
    }
    @media (max-width:560px){
      .service-grid{grid-template-columns:1fr}
      .gallery{grid-template-columns:1fr}
      header{flex-direction:column;gap:12px}
      .hero h1{font-size:30px}
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">
        <!-- If you have a logo file, replace src -->
        <img src="img-logo.png" alt="NINDECO logo" onerror="this.style.display='none'"/>
        <div>
          <strong>NINDECO</strong><br/>
          <span class="small">Your Trusted IKEA Kitchen Installer</span>
        </div>
      </div>
      <nav>
        <a href="#services">Services</a>
        <a href="#gallery">Gallery</a>
        <a href="#testimonials">Testimonials</a>
        <a href="#contact" class="btn" style="padding:10px 14px">WhatsApp for Quote</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero" id="hero">
      <div>
        <h1>Professional IKEA Kitchen Installation in Klang Valley</h1>
        <p class="lead">We install IKEA kitchens with care — cabinet assembly, quartz countertops, plumbing and electrical. Fast, neat and transparent pricing.</p>
        <a class="btn" href="https://wa.me/60189734598?text=Hi%20NINDECO%2C%20I%27d%20like%20a%20free%20quote%20for%20my%20IKEA%20kitchen.">WhatsApp Us for a Free Quote</a>

        <div style="margin-top:18px;color:var(--muted)">
          <strong>Service area:</strong> Klang Valley, Selangor, Putrajaya, Negeri Sembilan, Melaka. <br/>
          <strong>Email:</strong> <a href="mailto:nindecozr@gmail.com">nindecozr@gmail.com</a>
        </div>
      </div>

      <!-- hero image: use one of your team/kitchen photos -->
      <div>
        <img src="img1.jpg" alt="NINDECO team and kitchen" style="width:100%;border-radius:10px;object-fit:cover;box-shadow:0 6px 20px rgba(0,0,0,0.06)"/>
      </div>
    </section>

    <!-- PROBLEM + SOLUTION -->
    <section class="services" id="services">
      <div>
        <h3>Most people face delays, poor workmanship and hidden costs.</h3>
        <p class="small">We solve that — with certified installers, clear estimates and after-install support.</p>

        <div class="service-grid">
          <div class="service">
            <h4>IKEA Cabinet Installation</h4>
            <p class="small">Certified assembly, accurate leveling, hinge & drawer tuning, neat finishing.</p>
          </div>
          <div class="service">
            <h4>Quartz / Countertops</h4>
            <p class="small">Template, cutout for sinks & hobs, installation, and seam polishing.</p>
          </div>
          <div class="service">
            <h4>Plumbing & Electrical</h4>
            <p class="small">Sink plumbing, hob gas or electrical connection (certified subcontractors where required).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="gallery" style="margin-top:18px">
      <h3>Our Work</h3>
      <div class="gallery">
        <!-- replace these with the best project photos -->
        <img src="img2.jpg" alt="Project 1"/>
        <img src="img3.jpg" alt="Project 2"/>
        <img src="img4.jpg" alt="Project 3"/>
        <img src="img5.jpg" alt="Project 4"/>
        <img src="img6.jpg" alt="Project 5"/>
        <img src="img7.jpg" alt="Project 6"/>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section id="testimonials" class="testimonials">
      <h3>Testimonials</h3>
      <div class="testimonial">
        <strong>“Excellent work — punctual, clean and professional.”</strong>
        <p class="small">— Aisyah, Kajang</p>
      </div>
      <div class="testimonial">
        <strong>“Fast install and no hidden cost. Highly recommended.”</strong>
        <p class="small">— Mr. Hamid, Shah Alam</p>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" style="display:flex;gap:20px;margin-top:20px;flex-wrap:wrap;align-items:flex-start">
      <div class="contact-card">
        <h4>Get a Free Quote</h4>
        <p class="small">Send your IKEA layout or call/WhatsApp for a fast estimate.</p>
        <p><strong>WhatsApp:</strong> <a href="https://wa.me/60189734598?text=Hi%20NINDECO%2C%20I%27d%20like%20a%20free%20quote.">018-973 4598</a></p>
        <p><strong>Email:</strong> <a href="mailto:nindecozr@gmail.com">nindecozr@gmail.com</a></p>
        <p><strong>Service area:</strong> Klang Valley, Selangor, Putrajaya, Negeri Sembilan, Melaka</p>
      </div>

      <!-- Simple contact form (replace action with your form handling) -->
      <form action="https://formspree.io/f/your-form-id" method="POST" style="flex:1;min-width:280px;background:var(--card);padding:18px;border-radius:10px">
        <h4>Send layout / message</h4>
        <input type="text" name="name" placeholder="Your name" required style="width:100%;padding:10px;margin:8px 0;border-radius:6px;border:1px solid #ddd"/>
        <input type="email" name="email" placeholder="Your email" required style="width:100%;padding:10px;margin:8px 0;border-radius:6px;border:1px solid #ddd"/>
        <input type="text" name="phone" placeholder="Phone / WhatsApp" style="width:100%;padding:10px;margin:8px 0;border-radius:6px;border:1px solid #ddd"/>
        <textarea name="message" placeholder="Message or paste IKEA layout link" style="width:100%;padding:10px;margin:8px 0;border-radius:6px;border:1px solid #ddd;min-height:110px"></textarea>
        <button type="submit" class="btn" style="width:100%">Send & WhatsApp for quick reply</button>
      </form>
    </section>

    <footer>
      <div class="small">© <strong>NINDECO</strong> — Your Trusted IKEA Installer</div>
      <div class="small">Tel/WhatsApp: <a href="https://wa.me/60189734598">018-973 4598</a></div>
    </footer>
  </div>
</body>
</html>
